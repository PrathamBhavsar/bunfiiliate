{
  "name": "@bunfiiliate/js",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": { ".": { "types": "./dist/esm/index.d.ts", "import": "./dist/esm/index.js", "require": "./dist/cjs/index.cjs" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/cjs/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": { "@types/node": "^22.0.0", "esbuild": "^0.25.0", "typescript": "^5.9.0" }
}

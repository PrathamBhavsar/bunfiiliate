# ==============================================================================
# bunfiiliate environment configuration
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# Every variable listed below is read directly by the codebase.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Database & Networking (Required by bf-rt Config::from_env)
# ------------------------------------------------------------------------------
# PostgreSQL 16 connection string (SQLx pool)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bunfiiliate

# HTTP API server port (api serve)
API_PORT=8080

# Ingestion daemon port (tracker)
TRACKER_PORT=8081

# Secret key for JWT auth token signing (HS256) and tracker click signatures.
# Required, left empty on purpose so no known value ships: openssl rand -hex 32 (32+ bytes)
JWT_SECRET=
# Optional rotation list `kid:secret,kid:secret` (first signs, all verify). Replaces JWT_SECRET as the
# signer; JWT_SECRET, if also set, stays valid as kid `legacy`. Each secret 32+ bytes.
# BF_JWT_SECRETS=

# Master keys that encrypt secrets at rest (webhook, Stripe, Paddle secrets). Required, empty on purpose.
# Format kid:base64(32 bytes), comma separated, first is active. Generate: echo "k1:$(head -c32 /dev/urandom | base64)"
# Keep a copy outside the database backup: without the keys the encrypted secrets cannot be read.
BF_MASTER_KEYS=

# Secret salt for hashing visitor IPs in the tracker (required, empty on purpose): openssl rand -hex 32
BF_IP_SALT=

# ---- Docker Compose only (deploy/docker-compose.yml) -------------------------
# Run from the repo root: docker compose --env-file .env -f deploy/docker-compose.yml up -d
# Required, no defaults. POSTGRES_PASSWORD must be URL-safe (it is embedded in DATABASE_URL).
# POSTGRES_PASSWORD=
# Public https hostname Caddy serves and gets a certificate for.
# SITE_ADDRESS=affiliates.example.com
# -----------------------------------------------------------------------------

# Directory path for the segmented write-ahead log (WAL) spool
SPOOL_DIR=./var/spool

# ------------------------------------------------------------------------------
# Tracker Ingestion Options (crates/tracker/src/main.rs)
# ------------------------------------------------------------------------------
# Spool fsync mode: "always" (default, fsync once per group-commit batch) or "off" (benchmarks)
# BF_FSYNC=always

# Optional path to DB-IP Lite country database (MMDB format).
# Download via scripts/fetch-dbip.sh; if unset, tracker uses Cloudflare CF-IPCountry header only
# (and only when BF_TRUST_CF=1).
# BF_GEOIP_DB=data/dbip-country-lite.mmdb

# Trust CF-Connecting-IP / CF-IPCountry. Set to 1 only when Cloudflare fronts the server
# (then also remove the `request_header -CF-...` lines in deploy/Caddyfile).
# BF_TRUST_CF=0
# Comma-separated proxy addresses/CIDRs whose X-Forwarded-For the tracker trusts. Default none:
# the client is the TCP peer. The compose file defaults it to Docker's private ranges (Caddy);
# for a tracker behind a local reverse proxy on the same host use 127.0.0.1/32.
# BF_TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Email / Notification Options (crates/api/src/mail.rs)
# ------------------------------------------------------------------------------
# Outbound SMTP connection URL for lettre (e.g. smtps://user:password@smtp.example.com:465)
# If unset or empty, outgoing emails are logged via tracing instead of sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Default sender email address in outgoing notification emails
# SMTP_FROM="bunfiiliate <noreply@example.com>"
# Prometheus /metrics listener (never on the public port). Defaults: tracker 127.0.0.1:9100, api 127.0.0.1:9101
# BF_METRICS_ADDR=127.0.0.1:9100
# Require `Authorization: Bearer <token>` on /metrics
# BF_METRICS_TOKEN=

# ------------------------------------------------------------------------------
# Security & Cookies (crates/api/src/main.rs)
# ------------------------------------------------------------------------------
# Secure attribute on auth cookies: default is true (secure cookies enabled).
# Set to "0" or "false" only for local non-HTTPS development (with SITE_ADDRESS=:80);
# over plain HTTP the browser drops Secure cookies and login silently fails.
# COOKIE_SECURE=1

# Webhook endpoints may not point at loopback, private, link-local or metadata addresses
# (SSRF guard, checked at registration and at connect time). Set to 1 only for local
# development against a receiver on localhost; never in production.
# BF_ALLOW_PRIVATE_WEBHOOKS=0

# ------------------------------------------------------------------------------
# Observability & Logging (crates/rt/src/lib.rs)
# ------------------------------------------------------------------------------
# Tracing log filter: "error", "warn", "info", "debug", "trace"
# RUST_LOG=info

# ------------------------------------------------------------------------------
# First-run Bootstrap (crates/api/src/main.rs: api bootstrap)
# ------------------------------------------------------------------------------
# Can be supplied via CLI flags (--email, --password, --workspace) or environment variables:
# BF_ADMIN_EMAIL=admin@example.com
# BF_ADMIN_PASSWORD=change-me-admin-password
# BF_WORKSPACE_NAME="Default"

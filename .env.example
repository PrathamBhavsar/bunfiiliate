DATABASE_URL=postgres://postgres@localhost:5432/bunfiiliate
API_PORT=8080
TRACKER_PORT=8081
JWT_SECRET=change-me
SPOOL_DIR=./var/spool
# Optional DB-IP lite country database (scripts/fetch-dbip.sh); unset = CF-IPCountry only
# BF_GEOIP_DB=data/dbip-country-lite.mmdb
# Outbound email: lettre connection URL (e.g. smtps://user:pass@smtp.example.com:465); unset = log-only
# SMTP_URL=
# SMTP_FROM="bunfiiliate <noreply@example.com>"
# Prometheus /metrics listener (never on the public port). Defaults: tracker 127.0.0.1:9100, api 127.0.0.1:9101
# BF_METRICS_ADDR=127.0.0.1:9100
# Require `Authorization: Bearer <token>` on /metrics
# BF_METRICS_TOKEN=
